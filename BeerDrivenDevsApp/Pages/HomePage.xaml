<?xml version="1.0" encoding="utf-8"?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:BeerDrivenDevsApp.Controls"
             xmlns:vm="clr-namespace:BeerDrivenDevsApp.ViewModels"
             xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
             x:DataType="vm:HomeViewModel"
             x:Name="HomePageRef"
             x:Class="BeerDrivenDevsApp.Pages.HomePage"
             NavigationPage.HasNavigationBar="False">
    <Grid HorizontalOptions="Fill"
          VerticalOptions="Fill"
          RowDefinitions="2*, *, 12*"
          Padding="30,0,30,0"
          x:Name="MainLayout">
        <Image Source="bdd_logo.png"
               HorizontalOptions="Fill"
               Aspect="AspectFit"/>


        <FlexLayout Grid.Row="1"
                    HorizontalOptions="Fill"
                    Direction="Row"
                    JustifyContent="SpaceBetween"
                    AlignContent="Center"
                    AlignItems="Center">
            <Label VerticalOptions="Center"
                   VerticalTextAlignment="Center"
                   Text="{Binding HeaderLabel}"
                   FontSize="Large"
                   FontAttributes="Bold"
                   FontFamily="OpenSansSemibold"
                   TextColor="{StaticResource Amber900}"/>
            
            <ActivityIndicator IsVisible="{Binding IsCheckingForUpdates}"
                               IsRunning="{Binding IsCheckingForUpdates}"
                               Color="{DynamicResource Amber900}"/>
        </FlexLayout>
        
        <RefreshView Command="{Binding RefreshCommand}"
                     IsRefreshing="{Binding IsRefreshing}"
                     Grid.Row="2"
                     VerticalOptions="Fill"
                     HorizontalOptions="Fill">
               <CollectionView ItemsSource="{Binding LatestEpisodes}">
                  <CollectionView.ItemTemplate>
                      <DataTemplate>
                        <controls:EpisodeCard DownloadCommand="{Binding Source={x:Reference HomePageRef}, Path=BindingContext.DownloadEpisodeCommand}"
                                              CancelDownloadCommand="{Binding Source={x:Reference HomePageRef}, Path=BindingContext.CancelDownloadCommand}"/>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
               </CollectionView>
        </RefreshView>
    </Grid>
</ContentPage>