<?xml version="1.0" encoding="utf-8"?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:sn="clr-namespace:Plugin.Maui.SmartNavigation.Behaviours;assembly=Plugin.Maui.SmartNavigation"
             xmlns:controls="clr-namespace:BeerDrivenDevsApp.Controls"
             xmlns:vm="clr-namespace:BeerDrivenDevsApp.ViewModels"
             x:DataType="vm:CommunityViewModel"
             x:Class="BeerDrivenDevsApp.Pages.CommunityPage"
             NavigationPage.HasNavigationBar="False">
    <ContentPage.Behaviors>
        <sn:NavigatedInitBehavior />
    </ContentPage.Behaviors>
    
    <CollectionView VerticalOptions="Fill"
                    HorizontalOptions="Fill"
                    ItemsSource="{Binding Discussions}"
                    SelectionMode="None">
        <CollectionView.ItemTemplate>
            <DataTemplate>
                <controls:DiscussionHeaderCard />
            </DataTemplate>
        </CollectionView.ItemTemplate>
    </CollectionView>
</ContentPage>