<?xml version="1.0" encoding="utf-8"?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:fs="clr-namespace:FlagstoneUI.Core.Controls;assembly=FlagstoneUI.Core"
             xmlns:vm="clr-namespace:BeerDrivenDevsApp.ViewModels"
             x:DataType="vm:DiscussionCardViewModel"
             x:Class="BeerDrivenDevsApp.Controls.DiscussionHeaderCard">
    <fs:FsCard BorderColor="{DynamicResource Amber300}"
               Background="{DynamicResource BackgroundGradient}"
               HorizontalOptions="Fill"
               HeightRequest="80">
        <Grid ColumnDefinitions="70, *">
            <Image Source="{Binding Thumbnail}"
                   WidthRequest="70"
                   Aspect="AspectFill">
                <Image.Clip><RoundRectangleGeometry CornerRadius="10" /></Image.Clip>
            </Image>
            
            <HorizontalStackLayout Grid.Column="1"
                                   Spacing="1">
                <Label Text="{Binding EpisodeNumber, StringFormat='EP {0}'}"
                       TextColor="{DynamicResource Amber600}"
                       FontSize="8"/>
                <Label Text="{Binding Title}"
                       FontAttributes="Bold"
                       FontFamily="OpenSansSemibold"/>
                <HorizontalStackLayout Spacing="2">
                    <Label FontFamily="Lucide"
                           FontSize="8"
                           Text="{StaticResource MessageCircle}" />
                    <Label Text="{Binding CommentCount}"
                           FontSize="8"/>
                    <Label Text="{Binding ReleaseDate}"
                           FontSize="8"
                           IsVisible="{Binding IsReleaseDateVisible}"/>
                </HorizontalStackLayout>
            </HorizontalStackLayout>
        </Grid>
    </fs:FsCard>
</ContentView>